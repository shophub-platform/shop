# Server
SERVER_PORT=8081
APP_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DB_USER=shop
DB_PASSWORD=shop
DB_SSLMODE=disable

# Logging
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me-in-production

# Admin seed (created on startup if not exists)
ADMIN_EMAIL=admin@shophub.local
ADMIN_PASSWORD=admin1234

# Redis (optional — set DB_TYPE=redis to switch storage backend)
# DB_TYPE=redis
# REDIS_ADDR=localhost:6379
